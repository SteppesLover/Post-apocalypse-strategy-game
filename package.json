{
  "name": "game-desu",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "NODE_ENV=test mocha tests/*.test.js --timeout 5000 --exit",
    "test:e2e": "NODE_ENV=test mocha tests/puppeteer.js --timeout 60000 --exit",
    "test:all": "npm run test && npm run test:e2e",
    "dev": "nodemon app.js",
    "audit": "npm audit --omit=dev",
    "audit:full": "npm audit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "connect-mongodb-session": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "host-csrf": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "nodemon": "^3.1.11",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "mocha": "11.7.5",
    "puppeteer": "^24.37.5"
  }
}
